{
  "name": "arenaboard-p62",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild client/app.jsx --bundle --minify --outfile=public/app.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "prestart": "npm run build",
    "start": "node src/start.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/*.js' --test-coverage-exclude='src/start.js' tests/*.test.js",
    "evaluate": "node scripts/evaluate.js",
    "browser-test": "node scripts/browser-test.js"
  },
  "dependencies": {
    "esbuild": "^0.25.12",
    "express": "^5.3.0",
    "mongodb": "^6.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
